rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == userId || request.auth.token.email == 'rpakzad@taraazresearch.org');
    }

    match /evaluations/{evalId} {
      allow read, write: if request.auth != null &&
        (resource.data.userEmail == request.auth.token.email ||
         request.auth.token.email == 'rpakzad@taraazresearch.org');
      allow create: if request.auth != null;
    }

    // Partner organization for each evaluator (doc id = lowercased email).
    // Only the admin can assign; each user can read only their own entry.
    match /orgMemberships/{email} {
      allow read: if request.auth != null &&
        (request.auth.token.email == email ||
         request.auth.token.email == 'rpakzad@taraazresearch.org');
      allow write: if request.auth != null &&
        request.auth.token.email == 'rpakzad@taraazresearch.org';
    }

    match /accessRequests/{requestId} {
      allow create: if request.resource.data.email is string &&
                       request.resource.data.email.size() < 200 &&
                       request.resource.data.purpose is string &&
                       request.resource.data.purpose.size() < 1000 &&
                       request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null &&
        request.auth.token.email == 'rpakzad@taraazresearch.org';
    }
  }
}
